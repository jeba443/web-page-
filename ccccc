<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dairy Products Model</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: #f8f9fa;
    }

    .product-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .product-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 16px rgba(0,0,0,0.15);
    }

    .product-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-top-left-radius: 10px;
      border-top-right-radius: 10px;
    }

    .product-title {
      background: linear-gradient(45deg, #6fb1fc, #4364f7);
      color: white;
      padding: 10px;
      border-bottom-left-radius: 10px;
      border-bottom-right-radius: 10px;
      font-weight: 600;
    }

    footer {
      margin-top: 60px;
    }

    #carouselExampleCaptions {
      height: 75vh;
    }

    #carouselExampleCaptions .carousel-inner,
    #carouselExampleCaptions .carousel-item img {
      height: 75vh;
      object-fit: cover;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center" href="#home">
        <img src="images/new-logo.png" alt="Logo" width="40" height="40" class="me-2 rounded-circle ">
        <span>Dairy Home</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link active" href="#home">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="#products">Products</a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">Categories</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="#products">Milk</a></li>
              <li><a class="dropdown-item" href="#products">Butter</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="#products">Yogurt</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link" href="#footer">Contact</a></li>
        </ul>
        <form class="d-flex">
          <input class="form-control me-2" type="search" placeholder="Search Dairy" />
          <button class="btn btn-light" type="submit">Search</button>
        </form>
      </div>
    </div>
  </nav>

  <!-- Carousel (Home) -->
  <div id="home" style="padding-top: 56px;"></div>
  <div id="carouselExampleCaptions" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="images/flavourmilkdrinkbanner.png" class="d-block w-100" alt="Dairy Banner 1" />
        <div class="carousel-caption d-none d-md-block">
          <h5>Fresh Dairy Products</h5>
          <p>Quality milk and cheese delivered daily.</p>
        </div>
      </div>
      <div class="carousel-item">
        <img src="images/milkflag.jpg" class="d-block w-100" alt="Milk Glass" />
        <div class="carousel-caption d-none d-md-block">
          <h5>Natural Ingredients</h5>
          <p>Discover our range of healthy yogurt and butter.</p>
        </div>
      </div>
      <div class="carousel-item">
        <img src="images/sweet.jpg" class="d-block w-100" alt="Milk Glass" />
        <div class="carousel-caption d-none d-md-block">
          <h5>Sweet Dairy Delights</h5>
          <p>Made with love and tradition.</p>
        </div>
      </div>
      <div class="carousel-item">
        <img src="images/Icecreambanner.jpg" class="d-block w-100" alt="Cheese Varieties" />
        <div class="carousel-caption d-none d-md-block">
          <h5>Artisanal Cheese</h5>
          <p>From cheddar to mozzarella, find your favorite.</p>
        </div>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>
  </div>

  <!-- Product Categories -->
  <div id="products" class="container my-5">
    <h2 class="text-center mb-4">Our Product Categories</h2>
    <div class="row g-4">
      <!-- 12 Product Cards -->
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/milk.jpg" alt="Milk" class="product-img">
          <div class="product-title text-center">Milk</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/butter.jpg" alt="Butter" class="product-img">
          <div class="product-title text-center">Butter</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/panner.png" alt="Paneer" class="product-img">
          <div class="product-title text-center">Paneer</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/thickshake.png" alt="ThickShake" class="product-img">
          <div class="product-title text-center">ThickShake</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/yogurt.png" alt="Yogurt" class="product-img">
          <div class="product-title text-center">Yogurt</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/icecream.png" alt="Ice Cream" class="product-img">
          <div class="product-title text-center">Ice Cream</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/mysore.png" alt="Mysore Pak" class="product-img">
          <div class="product-title text-center">Mysore Pak</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/ghee.jpg" alt="Ghee" class="product-img">
          <div class="product-title text-center">Ghee</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/dooth.png" alt="Doodh Peda" class="product-img">
          <div class="product-title text-center">Doodh Peda</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/Lazzi.png" alt="Lassi" class="product-img">
          <div class="product-title text-center">Lassi</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/butter.jpg" alt="Butter Milk" class="product-img">
          <div class="product-title text-center">Butter Milk</div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="product-card bg-white rounded shadow">
          <img src="images/badham.jpg" alt="Badam Milk" class="product-img">
          <div class="product-title text-center">Badam Milk</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer id="footer" class="bg-dark text-light py-4">
    <div class="container text-center">
      <p class="h5">Dairy Footer</p>
      <p class="text-muted mb-0">© 2024 - Freshness Guaranteed</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
